@startuml er-nucleo-mvp
title ER Núcleo MVP — chaves e enums como tabelas
skinparam linetype ortho
hide circle
skinparam shadowing false

entity "status_operacional" as SO {
  * id_status_operacional : INT <<PK>>
  --
  codigo : VARCHAR(40)
  descricao : VARCHAR(120)
}

entity "status_sensor" as SS {
  * id_status_sensor : INT <<PK>>
  --
  codigo : VARCHAR(40)
  descricao : VARCHAR(120)
}

entity "tipo_sensor" as TS {
  * id_tipo_sensor : INT <<PK>>
  --
  codigo : VARCHAR(40)
  descricao : VARCHAR(120)
}

entity "tipo_alarme" as TA {
  * id_tipo_alarme : INT <<PK>>
  --
  codigo : VARCHAR(40)
  descricao : VARCHAR(120)
}

entity "status_alarme" as SA {
  * id_status_alarme : INT <<PK>>
  --
  codigo : VARCHAR(40)
  descricao : VARCHAR(120)
}

entity "reator" as R {
  * id_reator : INT <<PK>>
  --
  codigo : VARCHAR(40)
  id_status_operacional : INT <<FK>>
}

entity "turbina" as T {
  * id_turbina : INT <<PK>>
  --
  codigo : VARCHAR(40)
  id_reator : INT <<FK>>
  id_status_operacional : INT <<FK>>
}

entity "sensor" as S {
  * id_sensor : INT <<PK>>
  --
  codigo : VARCHAR(40)
  id_reator : INT <<FK>>
  id_tipo_sensor : INT <<FK>>
  id_status_sensor : INT <<FK>>
}

entity "medicao_reator" as M {
  * id_medicao : INT <<PK>>
  --
  id_sensor : INT <<FK>>
  id_reator : INT <<FK>>
  valor : DECIMAL
  unidade : VARCHAR(20)
  registrado_em : TIMESTAMP
}

entity "alarme" as A {
  * id_alarme : INT <<PK>>
  --
  id_medicao : INT <<FK>>
  id_sensor : INT <<FK>>
  id_tipo_alarme : INT <<FK>>
  id_status_alarme : INT <<FK>>
  mensagem : VARCHAR(255)
  emitido_em : TIMESTAMP
}

entity "limiar" as L {
  * id_limiar : INT <<PK>>
  --
  id_tipo_sensor : INT <<FK>>
  parametro : VARCHAR(40)
  valor_min : DECIMAL
  valor_max : DECIMAL
}

entity "registro_auditoria" as AUD {
  * id_registro : INT <<PK>>
  --
  tipo_evento : VARCHAR(80)
  payload : VARCHAR(2000)
  registrado_em : TIMESTAMP
}

R }o-- || SO
T }o-- || R
T }o-- || SO
S }o-- || R
S }o-- || TS
S }o-- || SS
M }o-- || S
M }o-- || R
A }o-- || M
A }o-- || S
A }o-- || TA
A }o-- || SA
L }o-- || TS

@enduml
