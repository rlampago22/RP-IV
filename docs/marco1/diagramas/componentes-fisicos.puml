@startuml componentes-fisicos-mvp
title Diagrama de Componentes Físicos — artefatos para versão executável (MVP)
skinparam componentStyle uml2
skinparam shadowing false

node "Host de execução (dev/lab)" {
  artifact "usina-controle-mvp.jar" as APP
  artifact "application.properties" as CFG
  artifact "logback.xml" as LOGCFG
  artifact "event-bus.jar\n(biblioteca in-process)" as BUSLIB
  artifact "h2-*.jar / sqlite-jdbc" as DBDRV
  database "reator.db\n(PersistenciaReator)" as DB
  artifact "README.md / scripts" as DOC
}

APP ..> CFG : lê
APP ..> LOGCFG : lê
APP --> BUSLIB : usa
APP --> DBDRV : usa
APP --> DB : persiste
DOC ..> APP : instrui execução

cloud "Simulador externo (opcional)" as SIM {
  artifact "sensor-simulator.jar" as SIMJAR
}
SIMJAR ..> APP : publica eventos\n(via API/CLI no Marco 2)\nou processo único

note bottom of APP
  Pacotes Java empacotados no JAR:
  controle.reator, alarmes,
  infraestrutura.eventos,
  auditoria.logs, persistencia.reator
end note

@enduml
