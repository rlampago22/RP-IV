@startuml pacotes-mvp-usina
title Diagrama de Pacotes — Sistema de Controle de Usina Nuclear (MVP RP4)
skinparam packageStyle rectangle
skinparam shadowing false

package "SistemaControleUsina" {

  package "InfraestruturaEventos" {
    [EventBus]
    [EventoDominio]
  }

  package "ControleReator" {
    [ReatorFacade]
    [AvaliadorLimiar]
  }

  package "Alarmes" {
    [AlarmeFacade]
  }

  package "PersistenciaReator" {
    [ReatorRepository]
  }

  package "AuditoriaLogs" {
    [AuditoriaSubscriber]
  }

  package "SegurancaAcesso" <<future>> {
    [AcessoFacade]
  }

  package "GestaoEmergencias" <<future>> {
    [EmergenciaFacade]
  }

  package "GestaoRH" <<future>> {
  }

  package "Evacuacao" <<future>> {
  }

  package "AnaliseRelatorios" <<future>> {
  }

  package "GestaoManutencao" <<future>> {
  }
}

ControleReator ..> InfraestruturaEventos : publica/consome
Alarmes ..> InfraestruturaEventos : publica/consome
AuditoriaLogs ..> InfraestruturaEventos : consome
ControleReator ..> PersistenciaReator : usa
ControleReator ..> Alarmes : via eventos
SegurancaAcesso ..> InfraestruturaEventos : «future»
GestaoEmergencias ..> InfraestruturaEventos : «future»

legend right
  |= Estereótipo |= Significado |
  | (sem) | Ativo no MVP Must |
  | <<future>> | Legado APS / backlog Should-Could-Won't |
endlegend

@enduml
