@startuml casos-de-uso-mvp
title Casos de Uso MVP — Sistema de Controle de Usina Nuclear
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Operador de Reator" as Op
actor "Supervisão Central" as Sup
actor "Sensor" as Sen
actor "Guarda / Acesso" as Guarda

rectangle "SistemaControleUsina" {
  usecase "UC01 Registrar Medição\nde Reator" as UC01
  usecase "UC02 Emitir Alarme\npor Limiar" as UC02
  usecase "UC03 Auditar Evento" as UC03
  usecase "UC04 Controlar Acesso\na Área Restrita" as UC04
}

Sen --> UC01
Op --> UC01
Op --> UC02
Sup --> UC02
Guarda --> UC04

UC01 ..> UC02 : «include»
UC01 ..> UC03 : «include»
UC02 ..> UC03 : «include»

note right of Sup
  Destinatário explícito
  dos alertas (feedback APS)
end note

note bottom of UC04
  Should — Marco 3
end note

@enduml
