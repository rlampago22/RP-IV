@startuml componentes-logicos-mvp
title Componentes Lógicos — implementação atual e integração planejada
skinparam componentStyle uml2
skinparam shadowing false

package "Frontend React" {
  component "T01 Visão Geral" as T01
  component "T02 Sensores" as T02
  component "T03 Alarmes" as T03
  component "T04 Auditoria" as T04
  component "T05 Cenários" as T05
  component "Estado compartilhado\nmvpDemoReducer" as Estado

  T01 --> Estado
  T02 --> Estado
  T03 --> Estado
  T04 --> Estado
  T05 --> Estado : executa cenário
}

package "Aplicação Java" {
  component "ReatorFacade" as RF <<Facade>>
  component "AlarmeFacade" as AF <<Facade>>
  component "AvaliadorFaixaSegura" as Aval <<Strategy>>
  component "AlarmeFactory" as Factory <<Factory>>
  component "EventBus" as Bus
  component "AuditoriaSubscriber" as Aud
  component "RegistroAuditoria" as Reg

  RF --> Bus : publica medição/observação/falha
  Bus --> AF : MedicaoRegistrada
  AF --> Aval
  AF --> Factory
  AF --> Bus : publica ciclo do alarme
  Bus --> Aud : todos os eventos
  Aud --> Reg : anexa entrada + SHA-256
}

component "API HTTP Java" as Api <<future>>
Estado ..> Api : substituir dados locais
Api ..> RF : registrar/consultar
Api ..> AF : listar/reconhecer/resolver
Api ..> Reg : consultar/verificar

note right of Bus
  Barramento síncrono,
  em memória e no processo Java.
end note

note bottom of Estado
  Integra T01–T05 na demonstração web atual.
  Ainda não chama o núcleo Java.
end note

@enduml
