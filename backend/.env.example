# Perfil local padrão: PostgreSQL instalado em localhost:5432.
# Nunca versione a senha real; defina-a apenas no terminal da sessão.
SPRING_PROFILES_ACTIVE=postgres
POSTGRES_URL=jdbc:postgresql://localhost:5432/usina
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina-uma-senha-local
APP_BOOTSTRAP_PASSWORD=defina-uma-senha-inicial-para-contas-de-teste
# Use true apenas por uma execução para atualizar as quatro contas locais existentes.
APP_RESET_BOOTSTRAP_PASSWORDS=false
